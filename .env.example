# 复制为 .env 后填写；已有 Key 可直接沿用，无需改名。
DASHSCOPE_API_KEY=
SEARCH_API_KEY=
AMAP_MAPS_API_KEY=
PEXELS_API_KEY=
MCP_ENABLED=false
AGENT_REACT_ENABLED=true
FRONTEND_PORT=8081
CORS_ALLOWED_ORIGINS=http://82.157.205.6:8081
# Windows 可改为 npx.cmd；Linux/macOS 使用 npx。
MCP_NPX_COMMAND=npx
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DATABASE_URL=jdbc:postgresql://localhost:5432/heart_pilot
DATABASE_USERNAME=heart_pilot
DATABASE_PASSWORD=heart_pilot
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true
KNOWLEDGE_CACHE_TTL_MINUTES=30
MODEL_CACHE_TTL_MINUTES=60
# qwen-plus 中国内地 0-128K 档位的估算单价；可按实际模型/地域覆盖。
AI_INPUT_CNY_PER_MILLION_TOKENS=0.8
AI_OUTPUT_CNY_PER_MILLION_TOKENS=2.0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=heart-pilot
